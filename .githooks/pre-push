#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$1" != origin ]; then
    echo 'Publication policy: push only main to origin.' >&2
    exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$local_ref" != refs/heads/main ] || [ "$remote_ref" != refs/heads/main ]; then
        echo 'Publication policy: branches other than main, tags and deletions are blocked.' >&2
        exit 1
    fi
    PYTHONDONTWRITEBYTECODE=1 python3 "$root/tools/check_publication.py" --ref "$local_oid"
done
