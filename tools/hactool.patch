+static int nca_check_bktr_metadata(nca_section_ctx_t *ctx, uint64_t tables_end) {
+    uint64_t offset, size;
+    memcpy(&offset, (const uint8_t *)ctx->header + 0x1A0, 8);
+    memcpy(&size, (const uint8_t *)ctx->header + 0x1A8, 8);
+    struct { uint64_t layer_offset; ivfc_hdr_t ivfc; } metadata;
+    if (size != sizeof(metadata) || offset < tables_end || offset > ctx->size || size > ctx->size - offset)
+        return 0;
+    nca_section_fseek(ctx, offset);
+    if (nca_section_fread(ctx, &metadata, sizeof(metadata)) != sizeof(metadata)) return 0;
+    uint8_t hash[0x20];
+    sha256_hash_buffer(hash, &metadata, sizeof(metadata));
+    if (memcmp(hash, (const uint8_t *)ctx->header + 0x1B0, sizeof(hash))) return 0;
+    ivfc_hdr_t *ivfc = &metadata.ivfc;
+    if (ivfc->magic != MAGIC_IVFC || ivfc->id != 0x20000 || ivfc->master_hash_size != 0x20 ||
+        ivfc->num_levels < 2 || ivfc->num_levels > IVFC_MAX_LEVEL + 1 ||
+        metadata.layer_offset < tables_end || metadata.layer_offset > offset) return 0;
+    uint64_t previous_offset = 0, previous_size = sizeof(ivfc->master_hash);
+    uint64_t tables_start = ctx->bktr_ctx.superblock->relocation_header.offset;
+    for (unsigned i = 0; i < ivfc->num_levels - 1; i++) {
+        ivfc_level_hdr_t *level = &ivfc->level_headers[i];
+        if (level->block_size < 4 || level->block_size > 20 || !level->hash_data_size) return 0;
+        uint64_t block_size = UINT64_C(1) << level->block_size;
+        uint64_t data_offset;
+        if (i == ivfc->num_levels - 2) {
+            data_offset = tables_start;
+            if (level->hash_data_size < tables_end - tables_start ||
+                level->hash_data_size > metadata.layer_offset - tables_start) return 0;
+        } else {
+            if (level->logical_offset > offset - metadata.layer_offset) return 0;
+            data_offset = metadata.layer_offset + level->logical_offset;
+        }
+        if (data_offset > offset || level->hash_data_size > offset - data_offset) return 0;
+        uint64_t hashes = level->hash_data_size / block_size + (level->hash_data_size % block_size != 0);
+        if (hashes > previous_size / 0x20) return 0;
+        validity_t valid = i ? nca_section_check_hash_table(ctx, previous_offset, data_offset,
+                level->hash_data_size, block_size, 1) :
+            nca_section_check_external_hash_table(ctx, ivfc->master_hash, data_offset,
+                level->hash_data_size, block_size, 1);
+        if (valid != VALIDITY_VALID) return 0;
+        previous_offset = data_offset;
+        previous_size = level->hash_data_size;
+    }
+    printf("BKTR Metadata Hashes (GOOD)\n");
+    return 1;
+}
